# ==============================================================================
# CrediWise Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=CrediWise
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (SQLite for local/hackathon development)
# Local PostgreSQL (Psycopg 3) example: postgresql+psycopg://postgres:your_password@localhost:5432/crediwise
DATABASE_URL=sqlite:///./crediwise.db

# Authentication & Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning Service Configuration
MODEL_PATH=ml/models/loan_model_v2.joblib
MODEL_VERSION=loan-model-v2.0
DEFAULT_CURRENCY=INR
DECISION_THRESHOLD=0.50
