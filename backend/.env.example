# ==============================================================================
# CrediWise Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security & JWT Authentication
# IMPORTANT: Generate a strong, random secret key for production deployments
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default: sqlite:///./crediwise.db
# Local PostgreSQL (Psycopg 3) example: postgresql+psycopg://postgres:your_password@localhost:5432/crediwise
# Cloud PostgreSQL example: postgresql+psycopg://user:password@host:5432/crediwise
DATABASE_URL=sqlite:///./crediwise.db

# CORS Configuration (Comma-separated or JSON list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Machine Learning Model Configuration
MODEL_PATH=ml/models/loan_model_v2.joblib
MODEL_VERSION=loan-model-v2.0
DEFAULT_CURRENCY=INR
